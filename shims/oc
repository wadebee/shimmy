#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)

SHIMMY_OC_VERSION_VALUE=${SHIMMY_OC_VERSION:-}

if [ -z "$SHIMMY_OC_VERSION_VALUE" ]; then
  printf 'ERROR: SHIMMY_OC_VERSION is required for the oc shim.\n' >&2
  printf '%s\n' 'Set SHIMMY_OC_VERSION to a supported major.minor (for example: 4.18, 4.20, 4.22).' >&2
  exit 1
fi

shim_name=
case "$SHIMMY_OC_VERSION_VALUE" in
  4.18)
    shim_name=oc_4_18
    ;;
  4.20)
    shim_name=oc_4_20
    ;;
  4.22)
    shim_name=oc_4_22
    ;;
  *)
    printf 'ERROR: unsupported SHIMMY_OC_VERSION value: %s\n' "$SHIMMY_OC_VERSION_VALUE" >&2
    printf '%s\n' 'Supported values: 4.18, 4.20, 4.22.' >&2
    exit 1
    ;;
fi

exec "$SCRIPT_DIR/$shim_name" "$@"
