#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)

SHIMMY_OC_DEFAULT_VERSION=4.20
SHIMMY_OC_VERSION_VALUE=${SHIMMY_OC_VERSION:-$SHIMMY_OC_DEFAULT_VERSION}

shim_name=
case "$SHIMMY_OC_VERSION_VALUE" in
  4.18)
    shim_name=oc_4_18
    ;;
  4.20)
    shim_name=oc_4_20
    ;;
  4.22)
    shim_name=oc_4_22
    ;;
  *)
    printf 'ERROR: unsupported SHIMMY_OC_VERSION value: %s\n' "$SHIMMY_OC_VERSION_VALUE" >&2
    printf '%s\n' 'Available oc versions: 4.18, 4.20, 4.22' >&2
    printf 'Default oc version: %s\n' "$SHIMMY_OC_DEFAULT_VERSION" >&2
    printf '%s\n' 'Run one of:' >&2
    printf '%s\n' '  shimmy install --shim oc' >&2
    printf '%s\n' '  shimmy install --shim oc@4.18' >&2
    printf '%s\n' '  shimmy install --shim oc@4.20' >&2
    printf '%s\n' '  shimmy install --shim oc@4.22' >&2
    exit 1
    ;;
esac

exec "$SCRIPT_DIR/$shim_name" "$@"
