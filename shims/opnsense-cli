#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
CUSTOM_IMAGE_HELPER_FILE=$SCRIPT_DIR/../lib/shims/custom-image.sh

OPNSENSE_CLI_IMAGES_DIR=$SCRIPT_DIR/../images/opnsense-cli
OPNSENSE_CLI_PULL_ARG=
OPNSENSE_CLI_RUN_IMAGE=
OPNSENSE_CLI_SSH_DIR=
OPNSENSE_CLI_TTY_ARG=

if [ ! -f "$CUSTOM_IMAGE_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$CUSTOM_IMAGE_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/custom-image.sh
. "$CUSTOM_IMAGE_HELPER_FILE"

shimmy_podman_preflight_require "the opnsense-cli shim"

if [ -n "${OPNSENSE_CLI_IMAGE:-}" ]; then
  OPNSENSE_CLI_RUN_IMAGE=$OPNSENSE_CLI_IMAGE
else
  if [ -n "${OPNSENSE_CLI_BASE_IMAGE:-}" ] && [ -n "${OPNSENSE_CLI_VERSION:-}" ]; then
    OPNSENSE_CLI_RUN_IMAGE=$(
      shimmy_local_image_ensure \
        "localhost/shimmy-opnsense-cli" \
        "$OPNSENSE_CLI_IMAGES_DIR" \
        "${OPNSENSE_CLI_IMAGE_BUILD:-auto}" \
        --build-arg "OPNSENSE_CLI_BASE_IMAGE=$OPNSENSE_CLI_BASE_IMAGE" \
        --build-arg "OPNSENSE_CLI_VERSION=$OPNSENSE_CLI_VERSION"
    )
  elif [ -n "${OPNSENSE_CLI_BASE_IMAGE:-}" ]; then
    OPNSENSE_CLI_RUN_IMAGE=$(
      shimmy_local_image_ensure \
        "localhost/shimmy-opnsense-cli" \
        "$OPNSENSE_CLI_IMAGES_DIR" \
        "${OPNSENSE_CLI_IMAGE_BUILD:-auto}" \
        --build-arg "OPNSENSE_CLI_BASE_IMAGE=$OPNSENSE_CLI_BASE_IMAGE"
    )
  elif [ -n "${OPNSENSE_CLI_VERSION:-}" ]; then
    OPNSENSE_CLI_RUN_IMAGE=$(
      shimmy_local_image_ensure \
        "localhost/shimmy-opnsense-cli" \
        "$OPNSENSE_CLI_IMAGES_DIR" \
        "${OPNSENSE_CLI_IMAGE_BUILD:-auto}" \
        --build-arg "OPNSENSE_CLI_VERSION=$OPNSENSE_CLI_VERSION"
    )
  else
    OPNSENSE_CLI_RUN_IMAGE=$(
      shimmy_local_image_ensure \
        "localhost/shimmy-opnsense-cli" \
        "$OPNSENSE_CLI_IMAGES_DIR" \
        "${OPNSENSE_CLI_IMAGE_BUILD:-auto}"
    )
  fi
fi

if [ -n "${OPNSENSE_CLI_IMAGE:-}" ] && [ "${OPNSENSE_CLI_IMAGE_PULL:-}" = "always" ]; then
  OPNSENSE_CLI_PULL_ARG=--pull=always
fi

if [ -n "${HOME:-}" ] && [ -d "$HOME/.ssh" ]; then
  OPNSENSE_CLI_SSH_DIR=$HOME/.ssh
fi

if [ -t 0 ] && [ -t 1 ]; then
  OPNSENSE_CLI_TTY_ARG=-it
fi

exec "$SHIMMY_PODMAN_BIN" run --rm \
  --platform "$SHIMMY_PODMAN_PLATFORM" \
  ${OPNSENSE_CLI_TTY_ARG:+"$OPNSENSE_CLI_TTY_ARG"} \
  ${OPNSENSE_CLI_PULL_ARG:+"$OPNSENSE_CLI_PULL_ARG"} \
  -v "$PWD:/work:rw" \
  -w /work \
  ${OPNSENSE_CLI_SSH_DIR:+"-v"} \
  ${OPNSENSE_CLI_SSH_DIR:+"$OPNSENSE_CLI_SSH_DIR:/root/.ssh:ro"} \
  "$OPNSENSE_CLI_RUN_IMAGE" \
  "$@"
