#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
SHIMMY_PODMAN_HELPER_FILE=$SCRIPT_DIR/../lib/shims/shimmy-podman.sh

SHIMMY_GCLOUD_CONTAINER_CONFIG_DIR=/home/cloudsdk/.config/gcloud
SHIMMY_GCLOUD_CONTAINER_HOME=/home/cloudsdk
SHIMMY_GCLOUD_CONTAINER_KUBECONFIG=/home/cloudsdk/.kube/config
SHIMMY_GCLOUD_CONTAINER_USER=cloudsdk
SHIMMY_GCLOUD_IMAGE=${SHIMMY_GCLOUD_IMAGE:-gcr.io/google.com/cloudsdktool/google-cloud-cli:stable}
SHIMMY_GCLOUD_IMAGE_PULL=${SHIMMY_GCLOUD_IMAGE_PULL:-}
SHIMMY_GCLOUD_HOST_CONFIG_DIR=
SHIMMY_GCLOUD_HOST_CONFIG_SOURCE=
SHIMMY_GCLOUD_KUBECONFIG=
SHIMMY_GCLOUD_PULL_ARG=
SHIMMY_GCLOUD_TTY_ARG=

shimmy_gcloud_path_absolute() {
  path_value=${1:?path is required}

  case "$path_value" in
    /*)
      printf '%s\n' "$path_value"
      ;;
    *)
      printf '%s\n' "$PWD/$path_value"
      ;;
  esac
}

shimmy_gcloud_config_dir_resolve() {
  if [ -n "${CLOUDSDK_CONFIG:-}" ]; then
    SHIMMY_GCLOUD_HOST_CONFIG_DIR=$(shimmy_gcloud_path_absolute "$CLOUDSDK_CONFIG")
    SHIMMY_GCLOUD_HOST_CONFIG_SOURCE=CLOUDSDK_CONFIG
    return 0
  fi

  if [ -n "${HOME:-}" ]; then
    SHIMMY_GCLOUD_HOST_CONFIG_DIR=$HOME/.config/gcloud
    SHIMMY_GCLOUD_HOST_CONFIG_SOURCE=HOME
    return 0
  fi

  SHIMMY_GCLOUD_HOST_CONFIG_DIR=
  SHIMMY_GCLOUD_HOST_CONFIG_SOURCE=
}

shimmy_gcloud_config_dir_ensure() {
  shimmy_gcloud_config_dir_resolve

  [ -n "$SHIMMY_GCLOUD_HOST_CONFIG_DIR" ] || return 0

  if [ -e "$SHIMMY_GCLOUD_HOST_CONFIG_DIR" ] && [ ! -d "$SHIMMY_GCLOUD_HOST_CONFIG_DIR" ]; then
    printf 'ERROR: gcloud config path exists but is not a directory: %s\n' "$SHIMMY_GCLOUD_HOST_CONFIG_DIR" >&2
    exit 1
  fi

  mkdir -p "$SHIMMY_GCLOUD_HOST_CONFIG_DIR"
}

shimmy_gcloud_config_help_print() {
  printf '%s\n' 'Shimmy gcloud configuration help'

  if [ -n "${HOME:-}" ]; then
    gcloud_config_path=$HOME/.config/gcloud
    kubeconfig_path=$HOME/.kube/config

    printf 'Host HOME: %s\n' "$HOME"

    if [ -d "$gcloud_config_path" ]; then
      printf 'Expected gcloud config directory: %s (present)\n' "$gcloud_config_path"
    else
      printf 'Expected gcloud config directory: %s (missing)\n' "$gcloud_config_path"
    fi

    if [ -f "$kubeconfig_path" ]; then
      printf 'Expected kubeconfig file: %s (present)\n' "$kubeconfig_path"
    else
      printf 'Expected kubeconfig file: %s (missing)\n' "$kubeconfig_path"
    fi
  else
    printf '%s\n' 'Host HOME: <unset>'
    printf '%s\n' 'Expected gcloud config directory: unavailable because HOME is unset'
    printf '%s\n' 'Expected kubeconfig file: unavailable because HOME is unset'
  fi

  if [ -n "${CLOUDSDK_CONFIG:-}" ]; then
    cloudsdk_config_path=$(shimmy_gcloud_path_absolute "$CLOUDSDK_CONFIG")
    if [ -d "$cloudsdk_config_path" ]; then
      printf 'Host CLOUDSDK_CONFIG: %s (present)\n' "$cloudsdk_config_path"
    else
      printf 'Host CLOUDSDK_CONFIG: %s (missing)\n' "$cloudsdk_config_path"
    fi
  else
    printf '%s\n' 'Host CLOUDSDK_CONFIG: <unset>'
  fi

  shimmy_gcloud_config_dir_resolve
  if [ -n "$SHIMMY_GCLOUD_HOST_CONFIG_DIR" ]; then
    if [ -d "$SHIMMY_GCLOUD_HOST_CONFIG_DIR" ]; then
      printf 'Effective host gcloud config directory: %s (present, source: %s)\n' "$SHIMMY_GCLOUD_HOST_CONFIG_DIR" "$SHIMMY_GCLOUD_HOST_CONFIG_SOURCE"
    else
      printf 'Effective host gcloud config directory: %s (missing, source: %s)\n' "$SHIMMY_GCLOUD_HOST_CONFIG_DIR" "$SHIMMY_GCLOUD_HOST_CONFIG_SOURCE"
    fi
  else
    printf '%s\n' 'Effective host gcloud config directory: unavailable because HOME and CLOUDSDK_CONFIG are unset'
  fi

  printf '%s\n' 'Mount policy: Shimmy creates the gcloud config directory, then mounts it read-write.'
  printf 'Container user: %s\n' "$SHIMMY_GCLOUD_CONTAINER_USER"
  printf 'Container HOME: %s\n' "$SHIMMY_GCLOUD_CONTAINER_HOME"
  printf 'Container CLOUDSDK_CONFIG: %s\n' "$SHIMMY_GCLOUD_CONTAINER_CONFIG_DIR"
  printf '%s\n' 'Mount policy: Shimmy mounts ~/.kube/config read-only when it exists.'
  printf '%s\n' 'Shimmy does not create credentials or Google Cloud CLI configuration files automatically.'
}

case "${1:-}" in
  --shimmy-config-help)
    shimmy_gcloud_config_help_print
    exit 0
    ;;
esac

if [ ! -f "$SHIMMY_PODMAN_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$SHIMMY_PODMAN_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/shimmy-podman.sh
. "$SHIMMY_PODMAN_HELPER_FILE"

shimmy_podman_preflight_require "the gcloud shim"

shimmy_gcloud_config_dir_ensure

if [ -n "${HOME:-}" ] && [ -f "$HOME/.kube/config" ]; then
  SHIMMY_GCLOUD_KUBECONFIG=$HOME/.kube/config
fi

if [ "$SHIMMY_GCLOUD_IMAGE_PULL" = "always" ]; then
  SHIMMY_GCLOUD_PULL_ARG=--pull=always
fi

if [ -t 0 ] && [ -t 1 ]; then
  SHIMMY_GCLOUD_TTY_ARG=-it
fi

exec "$SHIMMY_PODMAN_BIN" run --rm \
  --platform "$SHIMMY_PODMAN_PLATFORM" \
  ${SHIMMY_GCLOUD_PULL_ARG:+"$SHIMMY_GCLOUD_PULL_ARG"} \
  ${SHIMMY_GCLOUD_TTY_ARG:+"$SHIMMY_GCLOUD_TTY_ARG"} \
  --user "$SHIMMY_GCLOUD_CONTAINER_USER" \
  -v "$PWD:/work" \
  -w /work \
  ${SHIMMY_GCLOUD_HOST_CONFIG_DIR:+"-v"} \
  ${SHIMMY_GCLOUD_HOST_CONFIG_DIR:+"$SHIMMY_GCLOUD_HOST_CONFIG_DIR:$SHIMMY_GCLOUD_CONTAINER_CONFIG_DIR:rw"} \
  ${SHIMMY_GCLOUD_KUBECONFIG:+"-v"} \
  ${SHIMMY_GCLOUD_KUBECONFIG:+"$SHIMMY_GCLOUD_KUBECONFIG:$SHIMMY_GCLOUD_CONTAINER_KUBECONFIG:ro"} \
  -e CLOUDSDK_* \
  -e "CLOUDSDK_CONFIG=$SHIMMY_GCLOUD_CONTAINER_CONFIG_DIR" \
  -e "HOME=$SHIMMY_GCLOUD_CONTAINER_HOME" \
  "$SHIMMY_GCLOUD_IMAGE" \
  gcloud \
  "$@"
