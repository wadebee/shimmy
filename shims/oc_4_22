#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
SHIMMY_CUSTOM_IMAGE_HELPER_FILE=$SCRIPT_DIR/../lib/shims/custom-image.sh

SHIMMY_OC_4_22_IMAGES_DIR=$SCRIPT_DIR/../images/oc_4_22
SHIMMY_OC_4_22_PULL_ARG=
SHIMMY_OC_4_22_TTY_ARG=

if [ ! -f "$SHIMMY_CUSTOM_IMAGE_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$SHIMMY_CUSTOM_IMAGE_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/custom-image.sh
. "$SHIMMY_CUSTOM_IMAGE_HELPER_FILE"

shimmy_podman_preflight_or_preview_require "the oc 4.22 shim" "$@"

if [ -n "${SHIMMY_OC_4_22_IMAGE:-}" ]; then
  SHIMMY_OC_4_22_RUN_IMAGE=$SHIMMY_OC_4_22_IMAGE
else
  SHIMMY_OC_4_22_RUN_IMAGE=$(
    shimmy_local_image_ensure \
      "localhost/shimmy-oc-4_22" \
      "$SHIMMY_OC_4_22_IMAGES_DIR" \
      "${SHIMMY_OC_4_22_IMAGE_BUILD:-auto}"
  )
fi

if [ -n "${SHIMMY_OC_4_22_IMAGE:-}" ] && [ "${SHIMMY_OC_4_22_IMAGE_PULL:-}" = "always" ]; then
  SHIMMY_OC_4_22_PULL_ARG=--pull=always
fi

if [ -t 0 ] && [ -t 1 ]; then
  SHIMMY_OC_4_22_TTY_ARG=-it
fi

shimmy_podman_run_or_preview "$SHIMMY_PODMAN_BIN" run --rm \
  --platform "$SHIMMY_PODMAN_PLATFORM" \
  ${SHIMMY_OC_4_22_PULL_ARG:+"$SHIMMY_OC_4_22_PULL_ARG"} \
  ${SHIMMY_OC_4_22_TTY_ARG:+"$SHIMMY_OC_4_22_TTY_ARG"} \
  -v "$PWD:/work" \
  -w /work \
  ${KUBECONFIG:+-e KUBECONFIG} \
  "$SHIMMY_OC_4_22_RUN_IMAGE" \
  "$@"
