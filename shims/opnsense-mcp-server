#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
SHIMMY_PODMAN_HELPER_FILE=$SCRIPT_DIR/../lib/shims/shimmy-podman.sh

SHIMMY_OPNSENSE_MCP_API_KEY=${SHIMMY_OPNSENSE_MCP_API_KEY:-opnsense_mcp_api_key}
SHIMMY_OPNSENSE_MCP_API_SECRET=${SHIMMY_OPNSENSE_MCP_API_SECRET:-opnsense_mcp_api_secret}
SHIMMY_OPNSENSE_MCP_IMAGE=${SHIMMY_OPNSENSE_MCP_IMAGE:-docker.io/uhlenheide/opnsense-mcp-server}
SHIMMY_OPNSENSE_MCP_IMAGE_PULL=${SHIMMY_OPNSENSE_MCP_IMAGE_PULL:-}
SHIMMY_OPNSENSE_MCP_PULL_ARG=
OPNSENSE_VERIFY_SSL=${OPNSENSE_VERIFY_SSL:-false}
OPNSENSE_ALLOW_WRITES=${OPNSENSE_ALLOW_WRITES:-false}

shimmy_opnsense_mcp_url_preflight_require() {
  if [ -z "${OPNSENSE_URL:-}" ]; then
    printf '%s\n' 'ERROR: OPNSENSE_URL is required for the opnsense-mcp-server shim.' >&2
    printf '%s\n' 'Set OPNSENSE_URL to the OPNsense API base URL, including /api.' >&2
    return 1
  fi

  case "$OPNSENSE_URL" in
    http://?*|https://?*)
      ;;
    *)
      printf 'ERROR: OPNSENSE_URL must be an http:// or https:// URL with a host: %s\n' "$OPNSENSE_URL" >&2
      return 1
      ;;
  esac

  if ! command -v curl >/dev/null 2>&1; then
    printf '%s\n' 'ERROR: curl is required to validate OPNSENSE_URL before starting opnsense-mcp-server.' >&2
    return 1
  fi

  curl_tls_arg=
  if [ "${OPNSENSE_VERIFY_SSL:-}" = "false" ]; then
    curl_tls_arg=--insecure
  fi

  if ! curl --silent --show-error --output /dev/null --connect-timeout 10 --max-time 20 \
    ${curl_tls_arg:+"$curl_tls_arg"} \
    "$OPNSENSE_URL"; then
    printf 'ERROR: OPNSENSE_URL did not respond to curl: %s\n' "$OPNSENSE_URL" >&2
    printf '%s\n' 'Confirm the URL, network path, firewall reachability, and OPNSENSE_VERIFY_SSL setting.' >&2
    return 1
  fi
}

if [ ! -f "$SHIMMY_PODMAN_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$SHIMMY_PODMAN_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/shimmy-podman.sh
. "$SHIMMY_PODMAN_HELPER_FILE"

shimmy_opnsense_mcp_url_preflight_require
shimmy_podman_preflight_require "the opnsense-mcp-server shim"

if [ "$SHIMMY_OPNSENSE_MCP_IMAGE_PULL" = "always" ]; then
  SHIMMY_OPNSENSE_MCP_PULL_ARG=--pull=always
fi

exec "$SHIMMY_PODMAN_BIN" run --rm \
  --platform "$SHIMMY_PODMAN_PLATFORM" \
  -i \
  ${SHIMMY_OPNSENSE_MCP_PULL_ARG:+"$SHIMMY_OPNSENSE_MCP_PULL_ARG"} \
  -v "$PWD:/work" \
  -w /work \
  ${OPNSENSE_URL:+"-e"} \
  ${OPNSENSE_URL:+"OPNSENSE_URL=$OPNSENSE_URL"} \
  ${OPNSENSE_VERIFY_SSL:+"-e"} \
  ${OPNSENSE_VERIFY_SSL:+"OPNSENSE_VERIFY_SSL=$OPNSENSE_VERIFY_SSL"} \
  ${OPNSENSE_ALLOW_WRITES:+"-e"} \
  ${OPNSENSE_ALLOW_WRITES:+"OPNSENSE_ALLOW_WRITES=$OPNSENSE_ALLOW_WRITES"} \
  --secret "$SHIMMY_OPNSENSE_MCP_API_KEY,type=env,target=OPNSENSE_API_KEY" \
  --secret "$SHIMMY_OPNSENSE_MCP_API_SECRET,type=env,target=OPNSENSE_API_SECRET" \
  "$SHIMMY_OPNSENSE_MCP_IMAGE" \
  "$@"
