#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
PODMAN_HELPER_FILE=$SCRIPT_DIR/../lib/shims/shimmy-podman.sh

OPNSENSE_MCP_SERVER_API_KEY_SECRET=${OPNSENSE_MCP_SERVER_API_KEY_SECRET:-}
OPNSENSE_MCP_SERVER_API_SECRET_SECRET=${OPNSENSE_MCP_SERVER_API_SECRET_SECRET:-}
OPNSENSE_MCP_SERVER_IMAGE=${OPNSENSE_MCP_SERVER_IMAGE:-docker.io/uhlenheide/opnsense-mcp-server}
OPNSENSE_MCP_SERVER_IMAGE_PULL=${OPNSENSE_MCP_SERVER_IMAGE_PULL:-}
OPNSENSE_MCP_SERVER_PULL_ARG=

if [ ! -f "$PODMAN_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$PODMAN_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/shimmy-podman.sh
. "$PODMAN_HELPER_FILE"

shimmy_podman_preflight_require "the opnsense-mcp-server shim"

if [ "$OPNSENSE_MCP_SERVER_IMAGE_PULL" = "always" ]; then
  OPNSENSE_MCP_SERVER_PULL_ARG=--pull=always
fi

exec "$SHIMMY_PODMAN_BIN" run --rm \
  --platform "$SHIMMY_PODMAN_PLATFORM" \
  -i \
  ${OPNSENSE_MCP_SERVER_PULL_ARG:+"$OPNSENSE_MCP_SERVER_PULL_ARG"} \
  -v "$PWD:/work" \
  -w /work \
  ${OPNSENSE_URL:+"-e"} \
  ${OPNSENSE_URL:+"OPNSENSE_URL=$OPNSENSE_URL"} \
  ${OPNSENSE_VERIFY_SSL:+"-e"} \
  ${OPNSENSE_VERIFY_SSL:+"OPNSENSE_VERIFY_SSL=$OPNSENSE_VERIFY_SSL"} \
  ${OPNSENSE_ALLOW_WRITES:+"-e"} \
  ${OPNSENSE_ALLOW_WRITES:+"OPNSENSE_ALLOW_WRITES=$OPNSENSE_ALLOW_WRITES"} \
  ${OPNSENSE_MCP_SERVER_API_KEY_SECRET:+"--secret"} \
  ${OPNSENSE_MCP_SERVER_API_KEY_SECRET:+"$OPNSENSE_MCP_SERVER_API_KEY_SECRET,type=env,target=OPNSENSE_API_KEY"} \
  ${OPNSENSE_MCP_SERVER_API_SECRET_SECRET:+"--secret"} \
  ${OPNSENSE_MCP_SERVER_API_SECRET_SECRET:+"$OPNSENSE_MCP_SERVER_API_SECRET_SECRET,type=env,target=OPNSENSE_API_SECRET"} \
  "$OPNSENSE_MCP_SERVER_IMAGE" \
  "$@"
