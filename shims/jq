#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
SHIMMY_PODMAN_HELPER_FILE=$SCRIPT_DIR/../lib/shims/shimmy-podman.sh

SHIMMY_JQ_IMAGE=${SHIMMY_JQ_IMAGE:-ghcr.io/jqlang/jq:1.8.1}
SHIMMY_JQ_IMAGE_PULL=${SHIMMY_JQ_IMAGE_PULL:-}
SHIMMY_JQ_PULL_ARG=

if [ ! -f "$SHIMMY_PODMAN_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$SHIMMY_PODMAN_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/shimmy-podman.sh
. "$SHIMMY_PODMAN_HELPER_FILE"

shimmy_podman_preflight_require "the jq shim"

if [ "$SHIMMY_JQ_IMAGE_PULL" = "always" ]; then
  SHIMMY_JQ_PULL_ARG=--pull=always
fi

exec "$SHIMMY_PODMAN_BIN" run --rm -i \
  --platform "$SHIMMY_PODMAN_PLATFORM" \
  ${SHIMMY_JQ_PULL_ARG:+"$SHIMMY_JQ_PULL_ARG"} \
  -v "$PWD:/work" \
  -w /work \
  "$SHIMMY_JQ_IMAGE" \
  "$@"
