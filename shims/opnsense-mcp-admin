#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
SHIMMY_CUSTOM_IMAGE_HELPER_FILE=$SCRIPT_DIR/../lib/shims/custom-image.sh

SHIMMY_OPNSENSE_MCP_ADMIN_API_KEY=${SHIMMY_OPNSENSE_MCP_ADMIN_API_KEY:-opnsense_mcp_admin_api_key}
SHIMMY_OPNSENSE_MCP_ADMIN_API_SECRET=${SHIMMY_OPNSENSE_MCP_ADMIN_API_SECRET:-opnsense_mcp_admin_api_secret}
SHIMMY_OPNSENSE_MCP_ADMIN_IMAGES_DIR=$SCRIPT_DIR/../images/opnsense-mcp-admin
SHIMMY_OPNSENSE_MCP_ADMIN_PULL_ARG=
OPNSENSE_VERIFY_SSL=${OPNSENSE_VERIFY_SSL:-false}

shimmy_opnsense_mcp_admin_url_preflight_require() {
  if [ -z "${OPNSENSE_URL:-}" ]; then
    printf '%s\n' 'ERROR: OPNSENSE_URL is required for the opnsense-mcp-admin shim.' >&2
    printf '%s\n' 'Set OPNSENSE_URL to the OPNsense API base URL, including /api.' >&2
    return 1
  fi

  case "$OPNSENSE_URL" in
    http://?*|https://?*)
      ;;
    *)
      printf 'ERROR: OPNSENSE_URL must be an http:// or https:// URL with a host: %s\n' "$OPNSENSE_URL" >&2
      return 1
      ;;
  esac

  if ! command -v curl >/dev/null 2>&1; then
    printf '%s\n' 'ERROR: curl is required to validate OPNSENSE_URL before starting opnsense-mcp-admin.' >&2
    return 1
  fi

  curl_tls_arg=
  if [ "${OPNSENSE_VERIFY_SSL:-}" = "false" ]; then
    curl_tls_arg=--insecure
  fi

  if ! curl --silent --show-error --output /dev/null --connect-timeout 10 --max-time 20 \
    ${curl_tls_arg:+"$curl_tls_arg"} \
    "$OPNSENSE_URL"; then
    printf 'ERROR: OPNSENSE_URL did not respond to curl: %s\n' "$OPNSENSE_URL" >&2
    printf '%s\n' 'Confirm the URL, network path, firewall reachability, and OPNSENSE_VERIFY_SSL setting.' >&2
    return 1
  fi
}

if [ ! -f "$SHIMMY_CUSTOM_IMAGE_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$SHIMMY_CUSTOM_IMAGE_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/custom-image.sh
. "$SHIMMY_CUSTOM_IMAGE_HELPER_FILE"

shimmy_podman_preview_prepare "$@"

if ! shimmy_podman_is_preview; then
  case "${1:-}" in
    -h|--help)
      cat <<'EOF'
Run the admin-capable OPNsense MCP server through Shimmy.

WARNING: opnsense-mcp-admin exposes change-capable OPNsense management tools.
Use opnsense-mcp-read-only for inspection. Use this shim only during an
explicit change window with a rollback and verification path.

Required environment:
  OPNSENSE_URL

Required Podman secrets:
  opnsense_mcp_admin_api_key
  opnsense_mcp_admin_api_secret

Shimmy environment:
  SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE             override the runtime image
  SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE_PULL=always pull an override image before running
  SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE_BUILD=always rebuild the local source image
  SHIMMY_OPNSENSE_MCP_ADMIN_SOURCE_REF        override the Grousset git ref for local builds
EOF
      exit 0
      ;;
  esac
fi

if [ -n "${SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE:-}" ] && [ "${SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE_PULL:-}" = "always" ]; then
  SHIMMY_OPNSENSE_MCP_ADMIN_PULL_ARG=--pull=always
fi

if ! shimmy_podman_is_preview; then
  shimmy_opnsense_mcp_admin_url_preflight_require
  shimmy_podman_preflight_require "the opnsense-mcp-admin shim"
fi

if [ -n "${SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE:-}" ]; then
  SHIMMY_OPNSENSE_MCP_ADMIN_RUN_IMAGE=$SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE
else
  if [ -n "${SHIMMY_OPNSENSE_MCP_ADMIN_SOURCE_REF:-}" ]; then
    SHIMMY_OPNSENSE_MCP_ADMIN_RUN_IMAGE=$(
      shimmy_local_image_ensure \
        "localhost/shimmy-opnsense-mcp-admin" \
        "$SHIMMY_OPNSENSE_MCP_ADMIN_IMAGES_DIR" \
        "${SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE_BUILD:-auto}" \
        --build-arg "SHIMMY_OPNSENSE_MCP_ADMIN_SOURCE_REF=$SHIMMY_OPNSENSE_MCP_ADMIN_SOURCE_REF"
    )
  else
    SHIMMY_OPNSENSE_MCP_ADMIN_RUN_IMAGE=$(
      shimmy_local_image_ensure \
        "localhost/shimmy-opnsense-mcp-admin" \
        "$SHIMMY_OPNSENSE_MCP_ADMIN_IMAGES_DIR" \
        "${SHIMMY_OPNSENSE_MCP_ADMIN_IMAGE_BUILD:-auto}"
    )
  fi
fi

shimmy_podman_run_or_preview "$SHIMMY_PODMAN_BIN" run --rm \
  --platform "$SHIMMY_PODMAN_PLATFORM" \
  -i \
  ${SHIMMY_OPNSENSE_MCP_ADMIN_PULL_ARG:+"$SHIMMY_OPNSENSE_MCP_ADMIN_PULL_ARG"} \
  -v "$PWD:/work" \
  -w /work \
  ${OPNSENSE_URL:+"-e"} \
  ${OPNSENSE_URL:+"OPNSENSE_URL=$OPNSENSE_URL"} \
  ${OPNSENSE_VERIFY_SSL:+"-e"} \
  ${OPNSENSE_VERIFY_SSL:+"OPNSENSE_VERIFY_SSL=$OPNSENSE_VERIFY_SSL"} \
  --secret "$SHIMMY_OPNSENSE_MCP_ADMIN_API_KEY,type=env,target=OPNSENSE_API_KEY" \
  --secret "$SHIMMY_OPNSENSE_MCP_ADMIN_API_SECRET,type=env,target=OPNSENSE_API_SECRET" \
  "$SHIMMY_OPNSENSE_MCP_ADMIN_RUN_IMAGE" \
  "$@"
