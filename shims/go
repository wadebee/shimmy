#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
SHIMMY_PODMAN_HELPER_FILE=$SCRIPT_DIR/../lib/shims/shimmy-podman.sh

SHIMMY_GO_IMAGE=${SHIMMY_GO_IMAGE:-docker.io/library/golang:latest}
SHIMMY_GO_IMAGE_PULL=${SHIMMY_GO_IMAGE_PULL:-}
SHIMMY_GO_PULL_ARG=

if [ ! -f "$SHIMMY_PODMAN_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$SHIMMY_PODMAN_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/shimmy-podman.sh
. "$SHIMMY_PODMAN_HELPER_FILE"

shimmy_podman_preflight_or_preview_require "the go shim" "$@"

if [ "$SHIMMY_GO_IMAGE_PULL" = "always" ]; then
  SHIMMY_GO_PULL_ARG=--pull=always
fi

shimmy_podman_run_or_preview "$SHIMMY_PODMAN_BIN" run --rm \
  --platform "$SHIMMY_PODMAN_PLATFORM" \
  ${SHIMMY_GO_PULL_ARG:+"$SHIMMY_GO_PULL_ARG"} \
  -i \
  -v "$PWD:/work" \
  -w /work \
  --entrypoint go \
  "$SHIMMY_GO_IMAGE" \
  "$@"
