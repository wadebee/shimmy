#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
PODMAN_HELPER_FILE=$SCRIPT_DIR/../lib/shims/shimmy-podman.sh

GO_IMAGE=${GO_IMAGE:-docker.io/library/golang:latest}
GO_IMAGE_PULL=${GO_IMAGE_PULL:-}
GO_PULL_ARG=
GO_TTY_ARG=

if [ ! -f "$PODMAN_HELPER_FILE" ]; then
  printf 'ERROR: missing shim helper: %s\n' "$PODMAN_HELPER_FILE" >&2
  exit 1
fi

# shellcheck source=lib/shims/shimmy-podman.sh
. "$PODMAN_HELPER_FILE"

shimmy_podman_preflight_require "the go shim"

if [ "$GO_IMAGE_PULL" = "always" ]; then
  GO_PULL_ARG=--pull=always
fi

if [ -t 0 ] && [ -t 1 ]; then
  GO_TTY_ARG=-it
fi

exec "$SHIMMY_PODMAN_BIN" run --rm \
  ${GO_PULL_ARG:+"$GO_PULL_ARG"} \
  ${GO_TTY_ARG:+"$GO_TTY_ARG"} \
  -v "$PWD:/work" \
  -w /work \
  --entrypoint go \
  "$GO_IMAGE" \
  "$@"
