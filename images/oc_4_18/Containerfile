# Default base image is an unqualified short name so Podman can resolve it via
# /etc/containers/registries.conf. Override with SHIMMY_OC_4_18_BASE_IMAGE to
# point at a different short name or registry as needed.
ARG SHIMMY_OC_4_18_BASE_IMAGE=openshift4/ose-cli:4.18
FROM ${SHIMMY_OC_4_18_BASE_IMAGE}

WORKDIR /work

ENTRYPOINT ["oc"]
