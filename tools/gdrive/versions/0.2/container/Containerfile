ARG SHIMMY_GDRIVE_BASE_IMAGE
FROM ${SHIMMY_GDRIVE_BASE_IMAGE} AS build

ARG SHIMMY_GDRIVE_SOURCE_REF=5a94bdcb751975f9f6552d261da35314baf89c43

RUN apk add --no-cache git

WORKDIR /src

RUN git init \
    && git remote add origin https://github.com/isaacphi/mcp-gdrive.git \
    && git fetch --depth 1 origin "${SHIMMY_GDRIVE_SOURCE_REF}" \
    && git checkout FETCH_HEAD \
    && npm ci --omit=dev --ignore-scripts

FROM ${SHIMMY_GDRIVE_BASE_IMAGE}

WORKDIR /app

COPY --from=build /src/package.json /src/package-lock.json ./
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/dist ./dist

ENTRYPOINT ["node", "/app/dist/index.js"]
