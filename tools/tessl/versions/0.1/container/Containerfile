# Hardened Image at dhi.io/node:25-dev
ARG SHIMMY_TESSL_BASE_IMAGE
FROM ${SHIMMY_TESSL_BASE_IMAGE}
EXPOSE 8888
RUN --mount=type=secret,id=shimmy-host-ca-bundle \
  if [ -s /run/secrets/shimmy-host-ca-bundle ]; then \
    cp /run/secrets/shimmy-host-ca-bundle /usr/local/share/ca-certificates/shimmy-host-ca-bundle.crt; \
    update-ca-certificates; \
    rm /usr/local/share/ca-certificates/shimmy-host-ca-bundle.crt; \
  fi
RUN mkdir -p .npm-global \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gzip \
    && npm install -g @tessl/cli \
    && curl -fsSL https://get.tessl.io | sh \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=$PATH:$HOME/.npm-global/bin:$HOME/.config/shimmy/templates
ENV NPM_CONFIG_PREFIX=$HOME/.npm-global

# Node User
USER 1000 

ENTRYPOINT ["tessl"]
