ARG SHIMMY_OPNSENSE_MCP_ADMIN_BASE_IMAGE
FROM ${SHIMMY_OPNSENSE_MCP_ADMIN_BASE_IMAGE} AS build

ARG SHIMMY_OPNSENSE_MCP_ADMIN_SOURCE_REF=eeccd8189dc2d80fd397b2a589b20683ec947266

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN git init \
    && git remote add origin https://github.com/floriangrousset/opnsense-mcp-server.git \
    && git fetch --depth 1 origin "${SHIMMY_OPNSENSE_MCP_ADMIN_SOURCE_REF}" \
    && git checkout FETCH_HEAD \
    && python -m pip install --no-cache-dir build \
    && python -m build --wheel

FROM ${SHIMMY_OPNSENSE_MCP_ADMIN_BASE_IMAGE}

ARG SHIMMY_OPNSENSE_MCP_ADMIN_MCP_VERSION='mcp[cli]<1.10.0'

COPY --from=build /src/dist/*.whl /tmp/
RUN python -m pip install --no-cache-dir "$SHIMMY_OPNSENSE_MCP_ADMIN_MCP_VERSION" /tmp/*.whl \
    && rm /tmp/*.whl

COPY entrypoint.sh /usr/local/bin/shimmy-opnsense-mcp-admin-entrypoint
RUN chmod 755 /usr/local/bin/shimmy-opnsense-mcp-admin-entrypoint

WORKDIR /work

ENTRYPOINT ["shimmy-opnsense-mcp-admin-entrypoint"]
