ARG SHIMMY_TEXTUAL_BASE_IMAGE
FROM ${SHIMMY_TEXTUAL_BASE_IMAGE}

ARG SHIMMY_TEXTUAL_VERSION=8.2.7

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN --mount=type=secret,id=shimmy-host-ca-bundle \
  if [ -s /run/secrets/shimmy-host-ca-bundle ]; then \
    cp /run/secrets/shimmy-host-ca-bundle /usr/local/share/ca-certificates/shimmy-host-ca-bundle.crt; \
    update-ca-certificates; \
    rm /usr/local/share/ca-certificates/shimmy-host-ca-bundle.crt; \
  fi

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir "textual==${SHIMMY_TEXTUAL_VERSION}" textual-dev

WORKDIR /work

ENTRYPOINT ["textual"]
