ARG SHIMMY_JV_BASE_IMAGE
FROM ${SHIMMY_JV_BASE_IMAGE}

RUN --mount=type=secret,id=shimmy-host-ca-bundle \
  apk add --no-cache ca-certificates curl tar \
    && if [ -s /run/secrets/shimmy-host-ca-bundle ]; then \
      cp /run/secrets/shimmy-host-ca-bundle /usr/local/share/ca-certificates/shimmy-host-ca-bundle.crt; \
      update-ca-certificates; \
      rm /usr/local/share/ca-certificates/shimmy-host-ca-bundle.crt; \
    fi \
    &&
    && case "$(uname -m)" in \
         x86_64) jv_arch='amd64' ;; \
         aarch64) jv_arch='arm64' ;; \
         *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/santhosh-tekuri/jsonschema/releases/download/v6.0.3/jv-v6.0.3-linux-${jv_arch}.tar.gz" \
       | tar -xz -C /usr/local/bin jv \
    && chmod +x /usr/local/bin/jv \
    && apk del curl tar

ENTRYPOINT ["jv"]
