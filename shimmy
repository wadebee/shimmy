#!/bin/sh
set -eu

SCRIPT_DIR=$(
  cd -- "$(dirname -- "$0")" && pwd
)
ROOT_DIR=$SCRIPT_DIR
INSTALL_DIR=
INSTALLED_LAUNCHER=0

if [ -d "$SCRIPT_DIR/../core/commands" ]; then
  ROOT_DIR=$(
    cd -- "$SCRIPT_DIR/../core" && pwd
  )
  INSTALL_DIR=$(
    cd -- "$SCRIPT_DIR/.." && pwd
  )
  INSTALLED_LAUNCHER=1
  SHIMMY_CONTROL_INSTALL_DIR=$INSTALL_DIR
  export SHIMMY_CONTROL_INSTALL_DIR
fi

usage() {
  if [ "$INSTALLED_LAUNCHER" -eq 1 ]; then
    cat <<'EOF'
Manage an installed Shimmy environment.

Usage:
  shimmy <command> [options]

Commands:
  install [args...]     Install missing shims into this environment
  uninstall [args...]   Remove a profile from this installed environment
  activate [args...]    Print shell code that activates the installed shim paths now
  netinfo [args...]     Run commands/netinfo.sh
  skills [args...]      Run commands/skills.sh
  status [args...]      Run commands/status.sh
  test [args...]        Run tests/test.sh
  update [args...]      Run commands/update.sh
  help                  Show this help (default action if no command is given)

Examples:
  eval "$(shimmy activate)"
  shimmy install --shim opnsense-mcp-read-only
  shimmy uninstall --profile default
  shimmy netinfo
  shimmy skills install --target repo
  shimmy status
  shimmy status --available
  shimmy test
  shimmy update --pull --build --repair-startup
EOF
    return 0
  fi

  cat <<'EOF'
Manage shimmy from a single repo-root launcher.

Usage:
  shimmy <command> [options]

Commands:
  install [args...]     Run commands/install.sh
  uninstall [args...]   Run commands/install.sh --uninstall
  activate [args...]    Print shell code that activates the installed shim paths now
  netinfo [args...]     Run commands/netinfo.sh
  skills [args...]      Run commands/skills.sh
  status [args...]      Run commands/status.sh
  update [args...]      Run commands/update.sh
  test [args...]        Run tests/test.sh
  help                  Show this help (default action if no command is given)

Examples:
  ./shimmy install
  eval "$(./shimmy activate)"
  ./shimmy uninstall --profile default
  ./shimmy netinfo
  ./shimmy skills install --target repo
  ./shimmy status
  ./shimmy status --available
  ./shimmy update --pull --build --repair-startup
  ./shimmy test
EOF
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

run_repo_script() {
  script_path=${1:?script path is required}
  shift

  if [ ! -x "$script_path" ]; then
    fail "missing executable script: $script_path"
  fi

  exec "$script_path" "$@"
}

main() {
  command_name=${1:-help}

  case "$command_name" in
    help|-h|--help)
      usage
      ;;
    install)
      shift
      run_repo_script "$ROOT_DIR/commands/install.sh" "$@"
      ;;
    uninstall)
      shift
      run_repo_script "$ROOT_DIR/commands/install.sh" --uninstall "$@"
      ;;
    activate)
      shift
      run_repo_script "$ROOT_DIR/commands/activate.sh" "$@"
      ;;
    netinfo)
      shift
      run_repo_script "$ROOT_DIR/commands/netinfo.sh" "$@"
      ;;
    skills)
      shift
      run_repo_script "$ROOT_DIR/commands/skills.sh" "$@"
      ;;
    status)
      shift
      run_repo_script "$ROOT_DIR/commands/status.sh" "$@"
      ;;
    update)
      shift
      run_repo_script "$ROOT_DIR/commands/update.sh" "$@"
      ;;
    test)
      shift
      run_repo_script "$ROOT_DIR/tests/test.sh" "$@"
      ;;
    *)
      fail "unknown command: $command_name"
      ;;
  esac
}

main "$@"
